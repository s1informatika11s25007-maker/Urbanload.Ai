{
  "version": 2,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|favicon.ico|.*\\.(?:js|css|png|jpg|jpeg|svg|ico|json|woff2?)).*)",
      "destination": "/index.html"
    }
  ]
}
